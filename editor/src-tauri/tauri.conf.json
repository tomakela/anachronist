{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anachronist Editor",
  "version": "0.1.0",
  "identifier": "org.anachronist.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Anachronist Editor", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Editor for Anachronist adventure games"
  }
}
