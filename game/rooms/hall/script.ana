on enter() {
    if game.door_open == true {
        set door.open = true
        set door.graphic = placeholder.door_open
    }
    if game.clock_fallen == true {
        hide clock
        if game.fallen_clock_taken == false {
            show fallen_clock
        } else {
            hide fallen_clock
        }
    }
    if game.key_taken == true {
        hide key
    }
}

on door.walk() {
    walk player to door
    if game.door_open == true {
        enter room garden at entry
    }
}

on door.look() {
    if game.door_open == true {
        say "The door stands open to the garden."
    } else {
        say "A sturdy door leading to the garden."
    }
}

on clock.look() {
    say "The clock seems a little unsteady."
}

on fallen_clock.look() {
    if game.clock_cleaned == true {
        say "The clean face is stopped at twelve minutes past three."
    } else {
        say "The clock has had better moments. Its face is filthy."
    }
}

on key.look() {
    say "There is a key on the floor."
}

on trigger.enter(region) {
    if region == garden {
      if game.door_open == true {
        enter room garden at entry
      }
    }
}

on clock.take() {
    walk player to clock
    hide clock
    show fallen_clock
    set game.clock_fallen = true
    shake 24 ticks
    say "Ooops"
}

on fallen_clock.take() {
    walk player to fallen_clock
    take fallen_clock
    set game.fallen_clock_taken = true
    say "Taken."
}

on key.take() {
    walk player to key
    take key
    set game.key_taken = true
    say "Taken."
}

on door.use_item(item) {
    if item == key {
        sequence {
            walk player to key
            take key
            set game.key_taken = true
            walk player to door
            set door.open = true
            set door.graphic = placeholder.door_open
            set game.door_open = true
            set game.door_unlocked = true
            say "The key turns in the lock."
        }
    } else {
        if item == fallen_clock {
            if game.door_open == true {
                walk player to door
                remove fallen_clock from inventory
                set game.door_propped = true
                say "The fallen clock makes an excellent doorstop."
            } else {
                say "I need to open the door before I can prop it open."
            }
        } else {
            say "I can't do that."
        }
    }
}

on door.open() {
    if game.door_unlocked == true {
        walk player to door
        set door.open = true
        set door.graphic = placeholder.door_open
        set game.door_open = true
    } else {
        say "It is locked."
    }
}

on door.close() {
    if game.door_propped == true {
        say "The fallen clock is holding the door open."
    } else {
        if game.door_open == true {
            walk player to door
            set door.open = false
            set door.graphic = placeholder.door
            set game.door_open = false
        }
    }
}

on bush.look() {
    if game.stick_found == false {
        say "The dry bush has something caught deep between its branches."
    } else {
        say "There is nothing else in the bush."
    }
}

on bush.use_item(item) {
    if item == water {
        walk player to bush
        remove water from inventory
        show stick
        take stick
        set game.stick_found = true
        say "I pour the water onto the roots. A stick washes free."
    } else {
        say "That will not coax anything out of the bush."
    }
}

on stick.look() {
    say "A useful-looking stick."
}
