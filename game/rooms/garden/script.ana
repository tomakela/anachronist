on enter() {
    if game.coin_thrown == true {
        set fountain.graphic = placeholder.fountain_splash
    }
    if game.wire_fixed == true {
        set wire.graphic = placeholder.wire_fixed
    }
    if game.lamp_on == true {
        set lamp.graphic = placeholder.lamp_on
    }
}

on gate.walk() {
    walk player to gate
    enter room hall at garden
}

on gate.look() {
    say "It leads back into the hall."
}

on fountain.look() {
    if game.coin_thrown == true {
        say "My wish is resting beneath the sparkling water."
    } else {
        say "The fountain looks like a fine place to make a wish."
    }
}

on wire.look() {
    if game.wire_fixed == true {
        say "The key bridges the gap. The circuit is complete."
    } else {
        say "A broken wire leaves a key-sized gap in the circuit."
    }
}

on wire.use_item(item) {
    if item == key {
        walk player to wire
        remove key from inventory
        set wire.graphic = placeholder.wire_fixed
        set game.wire_fixed = true
        say "The brass key closes the circuit."
    } else {
        say "That does not conduct electricity well enough."
    }
}

on lamp.look() {
    if game.lamp_on == true {
        say "The repaired circuit makes the lamp glow warmly."
    } else {
        say "The switch is missing its button. A narrow stick might reach the mechanism."
    }
}

on lamp.open() {
    say "There is no button to press. I need something narrow to reach inside."
}

on lamp.close() {
    say "There is no button to press. I need something narrow to reach inside."
}

on lamp.use_item(item) {
    if item == stick {
        if game.wire_fixed == false {
            say "The stick reaches the switch mechanism, but the broken circuit supplies no power."
        } else {
            if game.lamp_on == true {
                walk player to lamp
                set lamp.graphic = placeholder.lamp_off
                set game.lamp_on = false
                say "I push the hidden mechanism with the stick. The lamp goes dark."
            } else {
                walk player to lamp
                set lamp.graphic = placeholder.lamp_on
                set game.lamp_on = true
                say "I push the hidden mechanism with the stick. The lamp flickers to life."
            }
        }
    } else {
        say "That will not fit into the empty switch socket."
    }
}

on fountain.use_item(item) {
    if item == coffee_cup {
        if game.coin_thrown == true {
            walk player to fountain
            replace coffee_cup with water in inventory
            say "I empty the cold coffee and fill the cup with fountain water."
        } else {
            say "It does not feel right to take from the fountain before making an offering."
        }
    } else {
      if item == coin {
        walk player to fountain
        remove coin from inventory
        set fountain.graphic = placeholder.fountain_splash
        set game.coin_thrown = true
        shake 8 ticks
        say "I toss the coin and make a wish."
      } else {
          say "That would not improve the fountain."
      }
    }
}
