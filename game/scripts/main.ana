module game.main;

on game.start() {
    set game.key_taken = false;
    set game.door_open = false;
    set game.door_unlocked = false;
    set game.clock_fallen = false;
    set game.fallen_clock_taken = false;
    enter room hall at entry;
    narrate "Find a way into the garden.";
}

on entity.look(target) {
    say "That looks interesting.";
    say "There may be more to discover here.";
}

on entity.walk(target) {
    if (target == door) {
        walk player to door;
        if (game.door_open == true) {
            enter room garden at entry;
        }
    } else {
        if (target == gate) {
            walk player to gate;
            enter room hall at garden;
            if (game.key_taken == true) {
                hide key;
            }
        }
    }
}

on trigger.enter(region) {
    if (region == garden) {
        if (game.door_open == true) {
            enter room garden at entry;
        }
    }
}

on room.enter(room) {
    if (room == hall) {
        if (game.door_open == true) {
            set door.open = true;
            set door.graphic = placeholder.door_open;
        }
        if (game.clock_fallen == true) {
            hide clock;
            if (game.fallen_clock_taken == false) {
                show fallen_clock;
            } else {
                hide fallen_clock;
            }
        }
    }
}

on entity.take(target) {
    walk player to target;
    if (target == clock) {
        hide clock;
        show fallen_clock;
        set game.clock_fallen = true;
        shake 24 ticks;
        say "Ooops";
    } else {
        if (target == fallen_clock) {
            take target;
            set game.fallen_clock_taken = true;
            say "Taken.";
        } else {
            take target;
            if (target == key) {
                set game.key_taken = true;
            }
            say "Taken.";
        }
    }
}

// Runtime expansion is atomic: none of these commands can start until the
// parser has accepted and expanded the complete sequence.
on entity.use_item(item, target) {
    if (target == door) {
        if (item == key) {
            sequence {
                walk player to key;
                take key;
                set game.key_taken = true;
                walk player to door;
                set door.open = true;
                set door.graphic = placeholder.door_open;
                set game.door_open = true;
                set game.door_unlocked = true;
                say "The key turns in the lock.";
            }
        } else {
            say "I can't do that.";
        }
    } else {
        say "I can't do that.";
    }
}

on entity.open(target) {
    if (target == door) {
        if (game.door_unlocked == true) {
            walk player to door;
            set door.open = true;
            set door.graphic = placeholder.door_open;
            set game.door_open = true;
        } else {
            say "It is locked.";
        }
    } else {
        say "I can't open that.";
    }
}

on entity.close(target) {
    if (target == door) {
        if (game.door_open == true) {
            walk player to door;
            set door.open = false;
            set door.graphic = placeholder.door;
            set game.door_open = false;
        }
    } else {
        say "I can't close that.";
    }
}

on entity.use(target) {
    say "Use it with what?";
}

on entity.talk(target) {
    say "It doesn't answer.";
}
